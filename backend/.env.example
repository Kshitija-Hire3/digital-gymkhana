# Copy to backend/.env and edit. Never commit backend/.env.
NODE_ENV=development
PORT=4000
# REQUIRED in production. In development a random secret is generated per start if empty.
JWT_SECRET=
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
# Relative to project root (or absolute)
DATA_DIR=data
# Prototype credentials used ONLY to seed demo data when data/store is empty.
SEED_DEMO_DATA=true
# Admin display name for the seeded administrator
DEMO_ADMIN_NAME=Waghchaure Sir
DEMO_ADMIN_EMAIL=admin@college.edu.in
DEMO_ADMIN_PASSWORD=admin123
# College Roll Number format (regex). Default: exactly 10 digits.
CRN_PATTERN=^[0-9]{10}$
